#!/system/bin/sh
# shellcheck disable=SC3043  # 'local' is supported by Android's /system/bin/sh (mksh)
# ============================================================
# bin/kasumi-proxyctl — typed backend facade for the Kasumi Proxy UI.
#
# The UI never builds raw shell snippets. It invokes:
#     kasumi-proxyctl <method> [args...]
# passing a single raw payload on stdin where needed, and reads
# a JSON result on stdout. This keeps shell quoting out of the UI
# and makes the backend testable on its own.
#
# Design note: to avoid depending on `jq` (not guaranteed on
# BusyBox/toybox), no method parses nested JSON. Payloads that
# are themselves JSON (app state, xray config) are written/echoed
# verbatim; scalar params (activeId, host, port, ...) are args.
# ============================================================

SCRIPT="$0"
case "$SCRIPT" in
  /*) ;;
  *) SCRIPT="$(pwd)/$SCRIPT" ;;
esac
BINDIR="${SCRIPT%/*}"
MODDIR="${BINDIR%/*}"
DATADIR="/data/adb/kasumi-proxy"
STATE="$DATADIR/app-state.json"
PROFILES="$DATADIR/profiles.json"
CONFIG="$DATADIR/config.json"
SINGBOX_CONFIG="$DATADIR/singbox.json"
ENGINE_FILE="$DATADIR/engine"
SOCKS_PORT_FILE="$DATADIR/local-socks-port"
TUN_IFACE_FILE="$DATADIR/tun-iface"
PROXY_CTL="$MODDIR/proxy_control.sh"
PIDFILE="$MODDIR/run/core.pid"
PIPE_FILE="$MODDIR/run/control.pipe"
SUB_WAKE_PIPE="$MODDIR/run/sub-wake.pipe"
# Lifecycle channel published by service.sh (connecting|running|stopped|failed:reason).
SERVICE_STATE_FILE="$DATADIR/service-state"
ASSET_JOB_DIR="$DATADIR/asset-jobs"
# Subscription bodies the auto-update daemon (service.sh) downloads on a schedule,
# awaiting parse by the UI. <id>.raw = body; <id>.fetched = last fetch epoch.
SUBCACHE_DIR="$DATADIR/sub-cache"
TEST_JOB_DIR="$DATADIR/test-jobs"

mkdir -p "$DATADIR" "$ASSET_JOB_DIR" "$TEST_JOB_DIR" 2>/dev/null

# Prefix for the on-demand test workloads (realping/speedtest core + curl). They
# run a full proxy core and pull a payload at line rate, which — at normal
# priority — starves the foreground WebUI of CPU and makes it stutter/freeze.
# Renicing them to the lowest priority lets the scheduler keep the UI smooth.
# Expanded UNQUOTED at the call site so it word-splits into `nice -n 19`; empty
# (a no-op prefix) when `nice` is unavailable. `nice` execs in place, so the
# backgrounded core keeps the same PID and `$!` stays valid for later kill.
if command -v nice >/dev/null 2>&1; then
    NICE="nice -n 19"
else
    NICE=""
fi

# ---------- small helpers ----------
# utils.sh sits next to this script; source-path=SCRIPTDIR makes the directive
# resolve regardless of the dir shellcheck is invoked from.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=utils.sh
. "$BINDIR/utils.sh"

# ============================================================
# Local helpers — kasumi-proxyctl only. Shared primitives are in bin/utils.sh.
# ============================================================

# ---------- process ----------

# pid_is_running_for_bin <pidfile> <bin>
pid_is_running_for_bin() {
    local pid
    [ -f "$1" ] || return 1
    pid=$(cat "$1" 2>/dev/null)
    pid_matches_bin "$pid" "$2"
}

# pid_is_running_for_any_core <pidfile> <bindir>
pid_is_running_for_any_core() {
    pid_is_running_for_bin "$1" "$2/xray" || pid_is_running_for_bin "$1" "$2/sing-box"
}

# is_running <pidfile> <bindir>
is_running() { pid_is_running_for_any_core "$1" "$2"; }

# running_engine <pidfile> <bindir> — engine owning the live core PID, empty if none.
# The engine marker is only the *intent* for the next start; after a failed
# switch the previous core keeps running, so status must report the PID's truth.
running_engine() {
    if pid_is_running_for_bin "$1" "$2/xray"; then
        echo "xray"
    elif pid_is_running_for_bin "$1" "$2/sing-box"; then
        echo "sing-box"
    fi
}

# ---------- core / status ----------

# core_version <bindir> [engine]
core_version() {
    local bindir="$1" eng="${2:-}"
    [ -z "$eng" ] && eng=$(read_engine "${ENGINE_FILE:-/dev/null}")
    if [ "$eng" = "sing-box" ]; then
        [ -x "$bindir/sing-box" ] &&
            "$bindir/sing-box" version 2>/dev/null | head -n1 | tr -d '\r' ||
            echo "sing-box (not installed)"
    elif [ -x "$bindir/xray" ]; then
        "$bindir/xray" version 2>/dev/null | head -n1 | tr -d '\r'
    else
        echo "Xray (not installed)"
    fi
}

# uptime_sec <pidfile>
uptime_sec() {
    [ -f "$1" ] || {
        echo 0
        return
    }
    local mtime now d
    mtime=$(stat -c %Y "$1" 2>/dev/null)
    now=$(date +%s 2>/dev/null)
    case "$mtime$now" in *[!0-9]*)
        echo 0
        return
        ;;
    esac
    [ -z "$mtime" ] && {
        echo 0
        return
    }
    d=$((now - mtime))
    [ "$d" -lt 0 ] && d=0
    echo "$d"
}

# read_traffic <tun_iface_file>
read_traffic() {
    local up=0 down=0 iface line
    iface=$(cat "$1" 2>/dev/null)
    [ -n "$iface" ] || {
        echo "$up $down"
        return
    }
    if [ -r /proc/net/dev ]; then
        line=$(sed 's/:/ /' /proc/net/dev 2>/dev/null | awk -v iface="$iface" '$1==iface{print}')
        if [ -n "$line" ]; then
            down=$(echo "$line" | awk '{print $2}')
            up=$(echo "$line" | awk '{print $10}')
            case "$down" in *[!0-9]*) down=0 ;; esac
            case "$up" in *[!0-9]*) up=0 ;; esac
        fi
    fi
    echo "$up $down"
}

# ---------- JSON ----------

# json_escape — escape stdin for embedding in a JSON string value
json_escape() {
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
        -e 's/\t/\\t/g' -e 's/\r//g' | awk 'BEGIN{ORS=""}{print (NR>1?"\\n":"") $0}'
}

# json_settings_num <file> <field>
json_settings_num() {
    sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p" "$1" 2>/dev/null | head -n1
}

# json_str_field <file> <field>
json_str_field() {
    [ -f "$1" ] || return 0
    sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$1" | head -n1
}

# atomic_write_json <dest>
atomic_write_json() {
    local dest="$1" tmp first
    tmp="$dest.tmp.$$"
    cat >"$tmp"
    first=$(tr -d '[:space:]' <"$tmp" | cut -c1)
    if [ -z "$first" ] || { [ "$first" != "{" ] && [ "$first" != "[" ]; }; then
        rm -f "$tmp"
        echo "ERR: payload is not JSON" >&2
        return 1
    fi
    mv -f "$tmp" "$dest"
}

# ---------- jobs ----------

# asset_job_path <asset_job_dir> <filename>
asset_job_path() { printf '%s/%s.json' "$1" "$2"; }

# write_asset_job_status <job_file> <state> <ok> <error>
write_asset_job_status() {
    local job_file="$1" job_state="$2" job_ok="$3" job_error="$4" tmp
    tmp="$job_file.tmp.$$"
    printf '{"state":"%s"' "$job_state" >"$tmp"
    [ -n "$job_ok" ] && printf ',"ok":%s' "$job_ok" >>"$tmp"
    [ -n "$job_error" ] && printf ',"error":"%s"' "$(printf '%s' "$job_error" | json_escape)" >>"$tmp"
    printf '}\n' >>"$tmp"
    mv -f "$tmp" "$job_file"
}

# test_job_path <test_job_dir> <port>
test_job_path() { printf '%s/%s.json' "$1" "$2"; }

# write_test_job <job_file> <inner_json>
write_test_job() {
    local tmp="$1.tmp.$$"
    printf '{%s}\n' "$2" >"$tmp"
    mv -f "$tmp" "$1"
}

# ---------- assets ----------

# convert_dat_to_srs <bindir> <datadir> <filename>
convert_dat_to_srs() {
    [ -x "$1/geodat2srs" ] || return 0
    case "$3" in
    geoip.dat) "$1/geodat2srs" geoip -i "$2/$3" -o "$2" --prefix "geoip-" 2>/dev/null ;;
    geosite.dat) "$1/geodat2srs" geosite -i "$2/$3" -o "$2" --prefix "geosite-" 2>/dev/null ;;
    esac
}

# download_asset_impl <filename> <mode> <url>
# Download an asset file into DATADIR honouring the update mode:
#   proxy  — only through the running core's SOCKS proxy
#   direct — only over the default route
#   auto   — try proxy first (if the core is up), fall back to direct
# Sets DOWNLOAD_ERROR on failure.
download_asset_impl() {
    DOWNLOAD_ERROR=""
    local filename="$1" mode="${2:-auto}" url="$3" dest tmp socks
    case "$filename" in
        ''|*/*|*'..'*|*\"*|*\\*) DOWNLOAD_ERROR="invalid filename"; return 1 ;;
    esac
    case "$mode" in
        auto|proxy|direct) ;;
        *) mode="auto" ;;
    esac
    if ! command -v curl >/dev/null 2>&1; then
        DOWNLOAD_ERROR="curl not available"
        return 1
    fi
    dest="$DATADIR/$filename"
    tmp="$dest.tmp.$$"
    socks="127.0.0.1:$(read_socks_port "$SOCKS_PORT_FILE")"
    if [ "$mode" = "proxy" ]; then
        if ! is_running "$PIDFILE" "$BINDIR"; then
            DOWNLOAD_ERROR="proxy not running"
            return 1
        fi
        if curl -fsSL --max-time 60 --socks5 "$socks" "$url" -o "$tmp" 2>/dev/null && [ -s "$tmp" ] && mv -f "$tmp" "$dest"; then
            return 0
        fi
        rm -f "$tmp" 2>/dev/null
        DOWNLOAD_ERROR="proxy download failed"
        return 1
    fi
    if [ "$mode" = "direct" ]; then
        if curl -fsSL --max-time 60 "$url" -o "$tmp" 2>/dev/null && [ -s "$tmp" ] && mv -f "$tmp" "$dest"; then
            return 0
        fi
        rm -f "$tmp" 2>/dev/null
        DOWNLOAD_ERROR="direct download failed"
        return 1
    fi
    # auto: proxy first (when the core is up), then direct
    if is_running "$PIDFILE" "$BINDIR"; then
        if curl -fsSL --max-time 60 --socks5 "$socks" "$url" -o "$tmp" 2>/dev/null && [ -s "$tmp" ] && mv -f "$tmp" "$dest"; then
            return 0
        fi
        rm -f "$tmp" 2>/dev/null
    fi
    if curl -fsSL --max-time 60 "$url" -o "$tmp" 2>/dev/null && [ -s "$tmp" ] && mv -f "$tmp" "$dest"; then
        return 0
    fi
    rm -f "$tmp" 2>/dev/null
    DOWNLOAD_ERROR="download failed"
    return 1
}

emit_status() { # [error] [forced_state]
    local status_error="$1" forced_state="$2" state sstate active up down up_secs core eng
    sstate=$(cat "$SERVICE_STATE_FILE" 2>/dev/null)
    if [ -n "$forced_state" ]; then
        state="$forced_state"
    else
        case "$sstate" in
            connecting) state="connecting" ;;
            failed:*)
                state="stopped"
                [ -z "$status_error" ] && status_error="${sstate#failed:}"
                ;;
            *)
                if is_running "$PIDFILE" "$BINDIR"; then state="running"; else state="stopped"; fi
                ;;
        esac
    fi
    active=$(json_str_field "$STATE" activeId)
    if [ -n "$active" ]; then active="\"$active\""; else active="null"; fi
    # shellcheck disable=SC2046  # read_traffic prints "up down" — intentional split
    set -- $(read_traffic "$TUN_IFACE_FILE"); up="$1"; down="$2"
    up_secs=$(uptime_sec "$PIDFILE")
    # Version/engine of the core that is actually running; the marker file is
    # only consulted when nothing is up (core_version falls back to it).
    eng=$(running_engine "$PIDFILE" "$BINDIR")
    core=$(core_version "$BINDIR" "$eng")
    [ -z "$eng" ] && eng=$(read_engine "$ENGINE_FILE")
    printf '{"state":"%s","activeId":%s,"uploadBytes":%s,"downloadBytes":%s,"uptimeSec":%s,"core":"%s","engine":"%s"' \
        "$state" "$active" "$up" "$down" "$up_secs" "$core" "$eng"
    [ -n "$status_error" ] && printf ',"error":"%s"' "$(printf '%s' "$status_error" | json_escape)"
    printf '}\n'
}

# ---------- methods ----------

method="$1"; shift

case "$method" in
    readState)
        if [ -f "$STATE" ]; then cat "$STATE"; else default_state; fi
        ;;

    writeState)
        if atomic_write_json "$STATE"; then
            echo '{"ok":true}'
        else
            echo '{"ok":false,"error":"invalid state payload"}'; exit 1
        fi
        ;;

    readProfiles)
        if [ -f "$PROFILES" ]; then cat "$PROFILES"; else echo '[]'; fi
        ;;

    writeProfiles)
        if atomic_write_json "$PROFILES"; then
            echo '{"ok":true}'
        else
            echo '{"ok":false,"error":"invalid profiles payload"}'; exit 1
        fi
        ;;

    resetState)
        default_state | atomic_write_json "$STATE" && cat "$STATE"
        ;;

    start)
        # stdin: full core config JSON; args: <activeId> <socksPort> <engine>
        socks_port="${2:-10808}"
        case "$socks_port" in (''|*[!0-9]*) socks_port=10808 ;; esac
        engine="${3:-xray}"
        case "$engine" in sing-box) dest="$SINGBOX_CONFIG" ;; *) engine="xray"; dest="$CONFIG" ;; esac
        if ! atomic_write_json "$dest"; then
            echo '{"ok":false,"error":"invalid config payload"}'; exit 1
        fi
        # engine marker selects the core service.sh will launch; clear the
        # other engine's config so only the chosen one is present.
        printf '%s' "$engine" > "$ENGINE_FILE"
        [ "$engine" = "sing-box" ] && rm -f "$CONFIG" 2>/dev/null
        [ "$engine" = "xray" ] && rm -f "$SINGBOX_CONFIG" 2>/dev/null
        printf '%s' "$socks_port" > "$SOCKS_PORT_FILE"
        # Async: kick an atomic restart through the control pipe and report
        # "connecting" immediately. service.sh owns the lifecycle from here and
        # publishes running/failed to the service-state channel, which status
        # polls surface. No fixed start timeout — a slow first start (one-time
        # .srs regeneration) is just a longer "connecting", not a failure.
        if [ ! -p "$PIPE_FILE" ]; then
            echo '{"state":"stopped","error":"service not running"}'; exit 0
        fi
        printf '%s' "connecting" > "$SERVICE_STATE_FILE"
        pipe_send "$PIPE_FILE" restart
        emit_status "" "connecting"
        ;;

    stop)
        lifecycle_error=""
        if ! sh "$PROXY_CTL" stop >/dev/null 2>&1; then
            lifecycle_error="proxy control stop failed; see proxy_control log"
        fi
        emit_status "$lifecycle_error"
        ;;

    restart)
        # Same async contract as start, but reuses the config already on disk.
        if [ ! -p "$PIPE_FILE" ]; then
            echo '{"state":"stopped","error":"service not running"}'; exit 0
        fi
        printf '%s' "connecting" > "$SERVICE_STATE_FILE"
        pipe_send "$PIPE_FILE" restart
        emit_status "" "connecting"
        ;;

    status)
        emit_status
        ;;

    log)
        # args: <target> <lines>
        target="${1:-service}"; lines="${2:-200}"
        case "$target" in
            xray)                  f="$DATADIR/xray.log" ;;
            singbox|sing-box)      f="$DATADIR/singbox.log" ;;
            tun2socks)             f="$DATADIR/tun2socks.log" ;;
            proxy|proxy_control)   f="$DATADIR/proxy_control.log" ;;
            service)               f="$DATADIR/service.log" ;;
            *)                     f="$DATADIR/service.log" ;;
        esac
        if [ -s "$f" ]; then
            tail -n "$lines" "$f"
        elif [ -f "$f" ]; then
            echo "(empty log: $f)"
        else
            echo "(no log: $f)"
        fi
        ;;

    rotateLogs)
        # reads logRotateMaxKb from app-state.json; falls back to 512
        _cfg=$(json_settings_num "$STATE" logRotateMaxKb)
        max_kb="${1:-${_cfg:-512}}"
        for f in "$DATADIR/service.log" "$DATADIR/xray.log" "$DATADIR/singbox.log" \
                 "$DATADIR/tun2socks.log" "$DATADIR/proxy_control.log"; do
            [ -f "$f" ] || continue
            size=$(wc -c < "$f" 2>/dev/null) || continue
            [ "$size" -gt "$((max_kb * 1024))" ] || continue
            tail -c "$((max_kb * 512))" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
        done
        ;;

    clearLogs)
        : > "$DATADIR/service.log" 2>/dev/null
        : > "$DATADIR/xray.log" 2>/dev/null
        : > "$DATADIR/singbox.log" 2>/dev/null
        : > "$DATADIR/tun2socks.log" 2>/dev/null
        : > "$DATADIR/proxy_control.log" 2>/dev/null
        echo '{"ok":true}'
        ;;

    pingStart)
        # args: <token> <host> <port>  — background TCP connect (tcping).
        # Returns {"ok":true} at once; poll `pingStatus <token>` for the result.
        # A blocking nc -w 3 inside ksu.exec freezes the WebUI for up to 3s per
        # unreachable host, so this runs as a job like realping/speedtest.
        pg_token="$1"; pg_host="$2"; pg_port="$3"
        case "$pg_token" in (''|*[!A-Za-z0-9_-]*) printf '{"ok":false,"error":"invalid token"}\n'; exit 0 ;; esac
        pg_job=$(test_job_path "$TEST_JOB_DIR" "$pg_token")
        if [ -z "$pg_host" ] || [ -z "$pg_port" ] || ! command -v nc >/dev/null 2>&1; then
            write_test_job "$pg_job" '"state":"done","ms":null'; printf '{"ok":true}\n'; exit 0
        fi
        write_test_job "$pg_job" '"state":"running"'
        (
            ms=null
            s=$(date +%s%N 2>/dev/null)
            if nc -w 3 -z "$pg_host" "$pg_port" >/dev/null 2>&1; then
                e=$(date +%s%N 2>/dev/null)
                case "$s$e" in
                    *[!0-9]*) ms=null ;;   # date +%s%N unsupported
                    *) ms=$(( (e - s) / 1000000 )); [ "$ms" -lt 0 ] && ms=0 ;;
                esac
            fi
            write_test_job "$pg_job" "\"state\":\"done\",\"ms\":$ms"
        ) >/dev/null 2>&1 &
        printf '{"ok":true}\n'
        ;;

    pingStatus)
        # args: <token>  -> the job JSON ({"state":"running"} | {"state":"done","ms":N|null})
        pg_token="$1"
        case "$pg_token" in (''|*[!A-Za-z0-9_-]*) printf '{"state":"idle"}\n'; exit 0 ;; esac
        pg_job=$(test_job_path "$TEST_JOB_DIR" "$pg_token")
        if [ -f "$pg_job" ]; then cat "$pg_job"; else printf '{"state":"idle"}\n'; fi
        ;;

    realpingStart)
        # stdin: core config JSON; args: <engine> <testUrl> <port>
        # Spawns the measurement in the background and returns {"ok":true}
        # immediately; the caller polls `realpingStatus <port>` for the result.
        # Never blocks on the core/curl — a multi-second ksu.exec freezes the UI.
        rp_engine="${1:-xray}"
        rp_url="${2:-http://www.gstatic.com/generate_204}"
        rp_port="${3:-0}"
        # The inbound port is baked into the stdin config by the caller and also
        # keys the job/temp files, so it must be passed explicitly and be unique.
        case "$rp_port" in (''|0|*[!0-9]*) printf '{"ok":false,"error":"port required (must match config inbound)"}\n'; exit 0 ;; esac
        rp_job=$(test_job_path "$TEST_JOB_DIR" "$rp_port")
        rp_cfg="$DATADIR/test-$rp_port.json"
        rp_pid="$DATADIR/test-$rp_port.pid"

        if ! command -v curl >/dev/null 2>&1; then
            write_test_job "$rp_job" '"state":"done","ms":-1,"error":"curl not available"'; printf '{"ok":true}\n'; exit 0
        fi
        if ! atomic_write_json "$rp_cfg"; then
            write_test_job "$rp_job" '"state":"done","ms":-1,"error":"invalid config"'; printf '{"ok":true}\n'; exit 0
        fi
        case "$rp_engine" in
            sing-box) rp_bin="$BINDIR/sing-box" ;;
            *)        rp_bin="$BINDIR/xray" ;;
        esac
        if [ ! -x "$rp_bin" ]; then
            write_test_job "$rp_job" '"state":"done","ms":-1,"error":"core not found"'; printf '{"ok":true}\n'; exit 0
        fi

        write_test_job "$rp_job" '"state":"running"'
        (
            # kill any leftover core bound to this port
            [ -f "$rp_pid" ] && { kill "$(cat "$rp_pid" 2>/dev/null)" 2>/dev/null; rm -f "$rp_pid"; }
            # start core in background (lowest priority — see $NICE rationale above)
            case "$rp_engine" in
                sing-box) $NICE "$rp_bin" run -c "$rp_cfg" >/dev/null 2>&1 & ;;
                *)        XRAY_LOCATION_ASSET="$DATADIR" $NICE "$rp_bin" run -c "$rp_cfg" >/dev/null 2>&1 & ;;
            esac
            echo $! > "$rp_pid"
            sleep 2
            rp_ms=-1
            rp_s=$(date +%s%N 2>/dev/null)
            if $NICE curl -fsS --max-time 5 --socks5 "127.0.0.1:$rp_port" -o /dev/null "$rp_url" 2>/dev/null; then
                rp_e=$(date +%s%N 2>/dev/null)
                case "$rp_s$rp_e" in
                    *[!0-9]*) rp_ms=-1 ;;
                    *) rp_ms=$(( (rp_e - rp_s) / 1000000 )); [ "$rp_ms" -lt 0 ] && rp_ms=-1 ;;
                esac
            fi
            kill "$(cat "$rp_pid" 2>/dev/null)" 2>/dev/null
            rm -f "$rp_pid" "$rp_cfg"
            write_test_job "$rp_job" "\"state\":\"done\",\"ms\":$rp_ms"
        ) >/dev/null 2>&1 &
        printf '{"ok":true}\n'
        ;;

    realpingStatus)
        # args: <port>  -> the job JSON ({"state":"running"} | {"state":"done","ms":N})
        rp_port="$1"
        case "$rp_port" in (''|*[!0-9]*) printf '{"state":"idle"}\n'; exit 0 ;; esac
        rp_job=$(test_job_path "$TEST_JOB_DIR" "$rp_port")
        if [ -f "$rp_job" ]; then cat "$rp_job"; else printf '{"state":"idle"}\n'; fi
        ;;

    speedtestStart)
        # stdin: core config JSON; args: <engine> <testUrl> <port> [<timeout>]
        # Background job; poll `speedtestStatus <port>` for {"bps":N}.
        st_engine="${1:-xray}"
        st_url="${2:-http://speed.cloudflare.com/__down?bytes=10000000}"
        st_port="${3:-0}"
        st_timeout="${4:-15}"
        case "$st_port" in (''|0|*[!0-9]*) printf '{"ok":false,"error":"port required (must match config inbound)"}\n'; exit 0 ;; esac
        st_job=$(test_job_path "$TEST_JOB_DIR" "$st_port")
        st_cfg="$DATADIR/test-$st_port.json"
        st_pid="$DATADIR/test-$st_port.pid"

        if ! command -v curl >/dev/null 2>&1; then
            write_test_job "$st_job" '"state":"done","bps":-1,"error":"curl not available"'; printf '{"ok":true}\n'; exit 0
        fi
        if ! atomic_write_json "$st_cfg"; then
            write_test_job "$st_job" '"state":"done","bps":-1,"error":"invalid config"'; printf '{"ok":true}\n'; exit 0
        fi
        case "$st_engine" in
            sing-box) st_bin="$BINDIR/sing-box" ;;
            *)        st_bin="$BINDIR/xray" ;;
        esac
        if [ ! -x "$st_bin" ]; then
            write_test_job "$st_job" '"state":"done","bps":-1,"error":"core not found"'; printf '{"ok":true}\n'; exit 0
        fi

        write_test_job "$st_job" '"state":"running"'
        (
            [ -f "$st_pid" ] && { kill "$(cat "$st_pid" 2>/dev/null)" 2>/dev/null; rm -f "$st_pid"; }
            # lowest priority — see $NICE rationale above
            case "$st_engine" in
                sing-box) $NICE "$st_bin" run -c "$st_cfg" >/dev/null 2>&1 & ;;
                *)        XRAY_LOCATION_ASSET="$DATADIR" $NICE "$st_bin" run -c "$st_cfg" >/dev/null 2>&1 & ;;
            esac
            echo $! > "$st_pid"
            sleep 2
            st_bps=-1
            # download through socks5, measure bytes/sec via curl's speed-meter.
            # -w writes to stdout AFTER the body; redirect body to /dev/null via -o,
            # capture only the -w output (speed) through a separate fd to avoid mixing.
            st_tmpfile=$(mktemp)
            exec 3>"$st_tmpfile"
            $NICE curl -fsS --max-time "$st_timeout" --socks5 "127.0.0.1:$st_port" \
                -o /dev/null -w "%{speed_download}" "$st_url" 2>/dev/null >&3
            exec 3>&-
            raw=$(cat "$st_tmpfile" 2>/dev/null)
            case "$raw" in
                ''|0|0.000) st_bps=-1 ;;
                *) st_bps=$(printf '%.0f' "$raw" 2>/dev/null) || st_bps=-1 ;;
            esac
            rm -f "$st_tmpfile"
            kill "$(cat "$st_pid" 2>/dev/null)" 2>/dev/null
            rm -f "$st_pid" "$st_cfg"
            write_test_job "$st_job" "\"state\":\"done\",\"bps\":$st_bps"
        ) >/dev/null 2>&1 &
        printf '{"ok":true}\n'
        ;;

    speedtestStatus)
        # args: <port>  -> the job JSON ({"state":"running"} | {"state":"done","bps":N})
        st_port="$1"
        case "$st_port" in (''|*[!0-9]*) printf '{"state":"idle"}\n'; exit 0 ;; esac
        st_job=$(test_job_path "$TEST_JOB_DIR" "$st_port")
        if [ -f "$st_job" ]; then cat "$st_job"; else printf '{"state":"idle"}\n'; fi
        ;;

    fetchSubscription)
        # args: <allowInsecure:0|1> <mode:auto|proxy|direct> <userAgent>; stdin: URL
        # Streams the raw subscription body to stdout, honouring the fetch mode
        # (mirrors download_asset_impl): proxy-only, direct-only, or auto (proxy
        # first when the core is up, then direct). On failure: empty stdout and a
        # non-zero exit, so the UI surfaces an error instead of "0 profiles".
        allow_insecure="${1:-0}"; mode="${2:-auto}"; user_agent="$3"
        case "$mode" in auto|proxy|direct) ;; *) mode="auto" ;; esac
        url=$(cat); url=$(echo "$url" | tr -d '\r\n')
        set -- curl -fsSL --max-time 30
        [ "$allow_insecure" = "1" ] && set -- "$@" -k
        [ -n "$user_agent" ] && set -- "$@" -A "$user_agent"
        socks="127.0.0.1:$(read_socks_port "$SOCKS_PORT_FILE")"
        sub_tmp="$DATADIR/.subfetch.$$"
        # proxy attempt: always in proxy mode; in auto mode only when the core is up.
        if [ "$mode" = "proxy" ] || { [ "$mode" = "auto" ] && is_running "$PIDFILE" "$BINDIR"; }; then
            if "$@" --socks5 "$socks" "$url" -o "$sub_tmp" 2>/dev/null && [ -s "$sub_tmp" ]; then
                cat "$sub_tmp"; rm -f "$sub_tmp"; exit 0
            fi
            rm -f "$sub_tmp"
            [ "$mode" = "proxy" ] && exit 1   # proxy-only never falls back to direct
        fi
        # direct attempt: direct mode, or the auto fallback after the proxy path.
        if "$@" "$url" -o "$sub_tmp" 2>/dev/null && [ -s "$sub_tmp" ]; then
            cat "$sub_tmp"; rm -f "$sub_tmp"; exit 0
        fi
        rm -f "$sub_tmp"
        exit 1
        ;;

    listSubCache)
        # List subscription bodies the daemon has downloaded: [{"id","fetchedAt"}]
        printf '['
        first=1
        if [ -d "$SUBCACHE_DIR" ]; then
            for f in "$SUBCACHE_DIR"/*.raw; do
                [ -f "$f" ] || continue
                base=${f##*/}; sc_id=${base%.raw}
                fetched=$(cat "$SUBCACHE_DIR/$sc_id.fetched" 2>/dev/null)
                case "$fetched" in (''|*[!0-9]*) fetched=0 ;; esac
                [ "$first" = 1 ] || printf ','
                first=0
                printf '{"id":"%s","fetchedAt":%s}' "$(printf '%s' "$sc_id" | json_escape)" "$fetched"
            done
        fi
        printf ']\n'
        ;;

    readSubCache)
        # arg: <subId>; prints the cached raw body (empty if none)
        sc_id="$1"
        case "$sc_id" in (''|*/*|*..*) exit 0 ;; esac
        cat "$SUBCACHE_DIR/$sc_id.raw" 2>/dev/null
        ;;

    clearSubCache)
        # arg: <subId>; drop the consumed body (keep .fetched as the schedule mark)
        sc_id="$1"
        case "$sc_id" in (''|*/*|*..*) exit 0 ;; esac
        rm -f "$SUBCACHE_DIR/$sc_id.raw"
        ;;

    downloadAsset)
        # args: <filename> <mode:auto|proxy|direct>; stdin: URL
        filename="$1"
        mode="${2:-auto}"
        url=$(cat); url=$(echo "$url" | tr -d '\r\n')
        if download_asset_impl "$filename" "$mode" "$url"; then
            convert_dat_to_srs "$BINDIR" "$DATADIR" "$filename"
            echo '{"ok":true}'
        else
            printf '{"ok":false,"error":"%s"}\n' "$(printf '%s' "$DOWNLOAD_ERROR" | json_escape)"
            exit 1
        fi
        ;;

    downloadAssetStart)
        # args: <filename> <mode:auto|proxy|direct>; stdin: URL
        filename="$1"
        mode="${2:-auto}"
        url=$(cat); url=$(echo "$url" | tr -d '\r\n')
        case "$filename" in
            ''|*/*|*'..'*|*\"*|*\\*)
                echo '{"ok":false,"error":"invalid filename"}'
                exit 1
                ;;
        esac
        case "$mode" in
            auto|proxy|direct) ;;
            *) mode="auto" ;;
        esac
        if [ "$mode" = "proxy" ] && ! is_running "$PIDFILE" "$BINDIR"; then
            echo '{"ok":false,"error":"proxy not running"}'
            exit 1
        fi
        job_file=$(asset_job_path "$ASSET_JOB_DIR" "$filename")
        write_asset_job_status "$job_file" "running" "" ""
        (
            if download_asset_impl "$filename" "$mode" "$url"; then
                convert_dat_to_srs "$BINDIR" "$DATADIR" "$filename"
                write_asset_job_status "$job_file" "done" "true" ""
            else
                write_asset_job_status "$job_file" "done" "false" "$DOWNLOAD_ERROR"
            fi
        ) >/dev/null 2>&1 &
        echo '{"ok":true}'
        ;;

    downloadAssetStatus)
        filename="$1"
        case "$filename" in
            ''|*/*|*'..'*|*\"*|*\\*)
                echo '{"state":"idle","ok":false,"error":"invalid filename"}'
                exit 1
                ;;
        esac
        job_file=$(asset_job_path "$ASSET_JOB_DIR" "$filename")
        if [ -f "$job_file" ]; then
            cat "$job_file"
        else
            echo '{"state":"idle"}'
        fi
        ;;

    listAssets)
        printf '['
        first=1
        for f in "$DATADIR"/*.dat; do
            [ -e "$f" ] || continue
            name="${f##*/}"
            [ "$first" = 1 ] && first=0 || printf ','
            printf '"%s"' "$name"
        done
        printf ']\n'
        ;;

    freePorts)
        # args: <start> <count> [<span>]  -> {"ports":[N,...]}
        # ONE snapshot of /proc/net/tcp{,6}: return <count> distinct, non-
        # overlapping port blocks (each <span> consecutive ports currently free).
        # The kernel only tells us which ports are *listening now*, so a caller
        # that needs several ports at once (parallel realping/speedtest workers)
        # must take them from a single snapshot here — asking port-by-port would
        # keep returning the same "free" port until a core actually binds it.
        fps_start="${1:-19000}"; fps_count="${2:-1}"; fps_span="${3:-1}"
        case "$fps_start" in (''|*[!0-9]*) fps_start=19000 ;; esac
        case "$fps_count" in (''|*[!0-9]*) fps_count=1 ;; esac
        case "$fps_span"  in (''|*[!0-9]*) fps_span=1 ;; esac
        [ "$fps_count" -lt 1 ] && fps_count=1
        [ "$fps_span"  -lt 1 ] && fps_span=1
        # Set of in-use ports as 4-hex-digit uppercase tokens (the field is
        # HEXIP:HEXPORT; split on ':' and take the port half).
        fps_used=" $(cat /proc/net/tcp /proc/net/tcp6 2>/dev/null \
            | awk '{ if (split($2, a, ":") == 2 && a[2] ~ /^[0-9A-Fa-f]+$/) print a[2] }' \
            | tr 'a-f' 'A-F' | tr '\n' ' ') "
        printf '{"ports":['
        fps_p="$fps_start"; fps_got=0; fps_first=1
        while [ "$fps_got" -lt "$fps_count" ] && [ "$fps_p" -le $(( 65000 - fps_span )) ]; do
            fps_ok=1; fps_i=0
            while [ "$fps_i" -lt "$fps_span" ]; do
                fps_hex=$(printf '%04X' $(( fps_p + fps_i )))
                case "$fps_used" in (*" $fps_hex "*) fps_ok=0; break ;; esac
                fps_i=$(( fps_i + 1 ))
            done
            if [ "$fps_ok" = 1 ]; then
                [ "$fps_first" = 1 ] && fps_first=0 || printf ','
                printf '%d' "$fps_p"
                fps_got=$(( fps_got + 1 ))
                fps_p=$(( fps_p + fps_span ))
            else
                fps_p=$(( fps_p + 1 ))
            fi
        done
        printf ']}\n'
        ;;

    capabilities)
        has_curl=false; command -v curl >/dev/null 2>&1 && has_curl=true
        has_tun=false; [ -e /dev/net/tun ] && has_tun=true
        core=$(core_version "$BINDIR" xray)
        singbox_version=""
        [ -x "$BINDIR/sing-box" ] && singbox_version=$(core_version "$BINDIR" sing-box)
        printf '{"bridge":"ksu","core":"%s","singboxVersion":"%s","curl":%s,"tun":%s}\n' \
            "$core" "$singbox_version" "$has_curl" "$has_tun"
        ;;

    listApps)
        # Returns [{"pkg":"com.example","uid":10001,"system":false}, ...]
        printf '['
        first=1
        while IFS= read -r line; do
            pkg=$(printf '%s' "$line" | sed -n 's/^package:\([^ ]*\).*/\1/p')
            uid=$(printf '%s' "$line" | sed -n 's/.*uid:\([0-9]*\).*/\1/p')
            [ -z "$pkg" ] || [ -z "$uid" ] && continue
            if [ "$uid" -lt 10000 ] 2>/dev/null; then sys="true"; else sys="false"; fi
            [ "$first" = 1 ] && first=0 || printf ','
            printf '{"pkg":"%s","uid":%s,"system":%s}' "$pkg" "$uid" "$sys"
        done <<EOF
$(pm list packages -U 2>/dev/null)
EOF
        printf ']
'
        ;;

    reloadAppFilter)
        # Re-applies iptables uid rules without restarting the core.
        if [ ! -p "$PIPE_FILE" ]; then
            echo '{"ok":false,"error":"service not running"}'
            exit 1
        fi
        pipe_send "$PIPE_FILE" reload-app-filter
        echo '{"ok":true}'
        ;;

    subWakeup)
        # Signal the subscription daemon to wake up and re-evaluate its schedule.
        pipe_send "$SUB_WAKE_PIPE" ''
        echo '{"ok":true}'
        ;;

    *)
        echo "{\"error\":\"unknown method: $method\"}" >&2
        exit 2
        ;;
esac
