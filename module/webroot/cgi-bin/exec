#!/system/bin/sh
# shellcheck disable=SC3043,SC3060  # 'local' and ${//} are mksh features (Android /system/bin/sh)
# ============================================================
# webroot/cgi-bin/exec — token-gated bridge to kasumi-proxyctl.
#
# The UI POSTs structured fields (it never sends a shell command):
#   argv  = base64( method \n arg1 \n arg2 ... )   (newline-joined)
#   stdin = base64( payload )                       (optional)
# This script rebuilds a fixed argv and execs the PINNED binary
#   $CTL "$@"
# It never `eval`s / `sh -c`s request data, so a leaked token cannot
# run arbitrary commands — only the kasumi-proxyctl methods, which validate
# themselves.
# ============================================================

echo "Content-Type: text/plain"
echo "Access-Control-Allow-Origin: *"
echo "Access-Control-Allow-Headers: Content-Type"
echo "Access-Control-Allow-Methods: POST, GET, OPTIONS"
echo ""

if [ "$REQUEST_METHOD" = "OPTIONS" ]; then
    exit 0
fi

SECRET_TOKEN="__SECRET_TOKEN__"
CTL="/data/adb/modules/kasumi-proxy/bin/kasumi-proxyctl"

REQ_TOKEN=$(echo "$QUERY_STRING" | sed -n 's/^.*token=\([^&]*\).*$/\1/p')
if [ -z "$REQ_TOKEN" ]; then
    REQ_TOKEN=$(echo "$QUERY_STRING" | grep -oE 'token=[^&]+' | cut -d= -f2)
fi

if [ "$REQ_TOKEN" != "$SECRET_TOKEN" ]; then
    echo '{"error":"Unauthorized (invalid token)"}'
    exit 1
fi

urldecode() {
    # urldecode <string>  (%XX → byte, + → space)
    local s="${1//+/ }"
    printf '%b' "${s//%/\\x}"
}

field() {
    # field <name>  — extract a urlencoded form field value from $POST_DATA
    echo "$POST_DATA" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n1
}

if [ "$REQUEST_METHOD" = "POST" ] && [ "${CONTENT_LENGTH:-0}" -gt 0 ]; then
    POST_DATA=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)
fi

ARGV_B64="$(urldecode "$(field argv)")"
STDIN_B64="$(urldecode "$(field stdin)")"

if [ -z "$ARGV_B64" ]; then
    echo '{"error":"empty argv"}'
    exit 1
fi

# Rebuild positional parameters from the newline-joined argv. A while-read
# loop (not word splitting) preserves empty arguments and never re-evaluates
# the decoded text as shell.
ARGV_DECODED=$(printf '%s' "$ARGV_B64" | base64 -d 2>/dev/null)
set --
while IFS= read -r __line || [ -n "$__line" ]; do
    set -- "$@" "$__line"
done <<EOF
$ARGV_DECODED
EOF

if [ -n "$STDIN_B64" ]; then
    printf '%s' "$STDIN_B64" | base64 -d 2>/dev/null | "$CTL" "$@"
else
    "$CTL" "$@"
fi
