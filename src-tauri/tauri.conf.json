{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kasumi Proxy",
  "mainBinaryName": "kasumi-desktop",
  "version": "0.0.0",
  "identifier": "moe.kasumi.proxy",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Kasumi Proxy",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/128x128.png",
      "tooltip": "Kasumi Proxy"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "System-wide transparent proxy (Xray-core / sing-box).",
    "longDescription": "Kasumi Proxy routes all traffic through Xray-core or sing-box with a native TUN and policy routing, managed from a clean React UI.",
    "license": "GPL-3.0-or-later",
    "publisher": "Kasumi Proxy",
    "homepage": "https://github.com/loss-and-quick/Kasumi-Proxy",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
